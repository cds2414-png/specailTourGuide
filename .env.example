# 모두의 여행길 환경 변수 예시
# 이 파일을 복사해 .env를 만들고 값을 채운다. .env는 git과 Vercel 배포에서 빠진다.
# 지금 사이트는 정적 페이지라 브라우저 코드가 이 값을 읽지 않는다.
# 결제 승인 같은 서버 기능(Vercel Functions)을 붙일 때 Vercel 프로젝트 설정 > Environment Variables에도 같은 이름으로 넣는다.

# 사이트 주소
SITE_URL=https://specialtourguide.vercel.app

# 토스페이먼츠 (https://developers.tosspayments.com 개발자센터 > API 키)
# 클라이언트 키: 브라우저에 노출돼도 되는 키 (test_ck_ / test_gck_ 로 시작)
TOSS_CLIENT_KEY=
# 시크릿 키: 서버에서만 쓴다. 브라우저 코드·공개 저장소에 절대 넣지 않는다 (test_sk_ / test_gsk_ 로 시작)
TOSS_SECRET_KEY=

# Upstage (Q&A 챗봇 임베딩: tools/build_chat_index.py, api/chat.js) — https://console.upstage.ai/api-keys
# 문서는 embedding-passage, 질문은 embedding-query(Solar 임베딩, 4096차원)로 바꾼다. 서버에서만 쓴다
UPSTAGE_API_KEY=

# OpenAI (Q&A 챗봇 답변: api/chat.js) — https://platform.openai.com/api-keys
# 서버에서만 쓴다. Vercel 프로젝트 설정 > Environment Variables에도 같은 이름으로 넣는다.
OPENAI_API_KEY=
# 답변 모델 (비우면 gpt-4o-mini)
OPENAI_MODEL=
